# OpenAI API Key (required for research-agent and content-agent)
OPENAI_API_KEY=your_openai_api_key_here

# Gmail API (required for email-agent)
# Place credentials.json in this directory
# Get it from: https://console.cloud.google.com/
GMAIL_CREDENTIALS_PATH=credentials.json

# User Information (for job-outreach-agent)
USER_NAME=Your Name
USER_EMAIL=your.email@gmail.com
USER_PHONE=+1234567890
USER_LINKEDIN=linkedin.com/in/yourprofile
USER_PORTFOLIO=https://yourportfolio.com
